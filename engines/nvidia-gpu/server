#!/bin/bash -eu

port="$(modelctl get http.port)"
host="$(modelctl get http.host)"
sleep_idle_seconds="$(modelctl get sleep-idle-seconds)"
min_context_size="$(modelctl get min-context-size)"
model_name=$("$SNAP_NAME" model --format=json | jq -r '.name')

mmproj_args=()
if [ -n "${MMPROJ_FILE:-}" ]; then
  mmproj_args=(--mmproj "$MMPROJ_FILE")
fi

cuda_check_attempts=3
cuda_check_delay=10
for ((attempt = 1; attempt <= cuda_check_attempts; attempt++)); do
  if devices="$(llama-server --list-devices 2>&1)"; then
    printf '%s\n' "$devices"
    if grep -qE '^[[:space:]]*CUDA[0-9]+:' <<< "$devices"; then
      break
    fi
    echo "No CUDA device found (attempt $attempt/$cuda_check_attempts)." >&2
  else
    printf '%s\n' "$devices" >&2
    echo "Failed to list devices (attempt $attempt/$cuda_check_attempts)." >&2
  fi

  if [ "$attempt" -eq "$cuda_check_attempts" ]; then
    echo "Unable to detect a CUDA device after $cuda_check_attempts attempts; refusing to start the server." >&2
    exit 1
  fi
  echo "Retrying CUDA device detection in $cuda_check_delay seconds." >&2
  sleep "$cuda_check_delay"
done

set -x

# Adding --no-warmup to skip the model warmup phase during server startup in order to reduce resource usage if not needed.
exec llama-server \
  --model "$MODEL_FILE" \
  --alias "$model_name" \
  "${mmproj_args[@]}" \
  --port "$port" \
  --host "$host" \
  --no-warmup \
  --sleep-idle-seconds "$sleep_idle_seconds" \
  --fit-ctx "$min_context_size" \
  "$@"
